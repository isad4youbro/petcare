# Copy to .env. No external services are required for the local app.
PORT=8000
PETCARE_HOST=127.0.0.1
# Obtain a bot token from @BotFather. Keep it private.
TELEGRAM_BOT_TOKEN=
# Optional model-backed answers. Without both variables, local record search is used.
OPENAI_API_KEY=
OPENAI_MODEL=
# Passwordless email delivery. For Brevo use smtp-relay.brevo.com:587,
# your SMTP login, a separate SMTP key, and a verified sender address.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# Set to 1 behind HTTPS before public deployment.
PETCARE_SECURE_COOKIES=0
# Public contact URI required by Web Push providers; replace before public deployment.
VAPID_SUBJECT=mailto:admin@petcare.local
