{
  "name": "@petcare/pixel-pets",
  "version": "1.0.0",
  "description": "Пиксельные анимированные аватары питомцев для PetCare: 167 видов и пород, пресеты, конструктор, раскраска.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./sprite": "./src/sprite.js",
    "./react": "./src/react.js",
    "./node": "./src/node.js",
    "./schema": "./config.schema.json"
  },
  "files": ["src", "config.schema.json", "README.md"],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage.lcov \"tests/**/*.test.js\""
  },
  "peerDependencies": { "react": ">=17" },
  "peerDependenciesMeta": { "react": { "optional": true } },
  "engines": { "node": ">=20" },
  "license": "MIT"
}
